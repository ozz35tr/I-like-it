rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedSignedIn() && request.auth.uid == userId;
    }

    function isValidSharedPlace(data) {
      return data.keys().hasAll([
          'ownerId',
          'authorName',
          'visibility',
          'name',
          'category',
          'mapsUrl',
          'coverImage',
          'latestComment',
          'avgRating',
          'reviewCount',
          'ratingSum',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'authorName',
          'visibility',
          'name',
          'category',
          'mapsUrl',
          'coverImage',
          'latestComment',
          'avgRating',
          'reviewCount',
          'ratingSum',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.authorName is string &&
        data.authorName.size() >= 1 &&
        data.authorName.size() <= 60 &&
        data.visibility == 'shared' &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 100 &&
        data.category in ['restaurant', 'cafe', 'bakery', 'bistro'] &&
        data.mapsUrl is string &&
        data.mapsUrl.size() <= 600 &&
        data.coverImage is string &&
        data.coverImage.size() <= 160000 &&
        data.latestComment is string &&
        data.latestComment.size() <= 1500 &&
        data.avgRating is number &&
        data.avgRating >= 0 &&
        data.avgRating <= 5 &&
        data.reviewCount is number &&
        data.reviewCount >= 0 &&
        data.reviewCount <= 10000 &&
        data.ratingSum is number &&
        data.ratingSum >= 0 &&
        data.ratingSum <= 50000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSharedReview(data, placeId) {
      return data.keys().hasAll([
          'ownerId',
          'authorName',
          'visibility',
          'placeId',
          'rating',
          'comment',
          'photos',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'authorName',
          'visibility',
          'placeId',
          'rating',
          'comment',
          'photos',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.authorName is string &&
        data.authorName.size() >= 1 &&
        data.authorName.size() <= 60 &&
        data.visibility == 'shared' &&
        data.placeId is string &&
        isValidId(data.placeId) &&
        data.placeId == placeId &&
        data.rating is number &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.comment is string &&
        data.comment.size() >= 2 &&
        data.comment.size() <= 1500 &&
        data.photos is list &&
        data.photos.size() <= 2 &&
        (data.photos.size() == 0 || (data.photos[0] is string && data.photos[0].size() <= 160000)) &&
        (data.photos.size() < 2 || (data.photos[1] is string && data.photos[1].size() <= 160000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Shared Collaborative Places & Reviews
    match /places/{placeId} {
      allow get: if isValidId(placeId) &&
        isVerifiedSignedIn() &&
        existing().visibility == 'shared';

      allow list: if isVerifiedSignedIn() &&
        resource.data.visibility == 'shared';

      allow create: if isValidId(placeId) &&
        isVerifiedSignedIn() &&
        isValidSharedPlace(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(placeId) &&
        isVerifiedSignedIn() &&
        isValidSharedPlace(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().authorName == existing().authorName &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['mapsUrl', 'updatedAt'])
          ) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'avgRating',
            'reviewCount',
            'ratingSum',
            'latestComment',
            'coverImage',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(placeId) &&
        isVerifiedSignedIn() &&
        existing().ownerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow get: if isValidId(placeId) &&
          isValidId(reviewId) &&
          isVerifiedSignedIn() &&
          existing().visibility == 'shared';

        allow list: if isVerifiedSignedIn() &&
          resource.data.visibility == 'shared';

        allow create: if isValidId(placeId) &&
          isValidId(reviewId) &&
          isVerifiedSignedIn() &&
          isValidSharedReview(incoming(), placeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          getAfter(/databases/$(database)/documents/places/$(placeId)).data.visibility == 'shared';

        allow update: if false;

        allow delete: if isValidId(placeId) &&
          isValidId(reviewId) &&
          isVerifiedSignedIn() &&
          existing().ownerId == request.auth.uid;
      }
    }

    // Legacy Per-User Private Places (retained for one-click migration to shared list)
    match /users/{userId}/places/{placeId} {
      allow get: if isValidId(userId) &&
        isValidId(placeId) &&
        isVerifiedOwner(userId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isValidId(userId) &&
        isVerifiedOwner(userId) &&
        resource.data.ownerId == request.auth.uid;

      allow create: if false;
      allow update: if false;

      allow delete: if isValidId(userId) &&
        isValidId(placeId) &&
        isVerifiedOwner(userId) &&
        existing().ownerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow get: if isValidId(userId) &&
          isValidId(placeId) &&
          isValidId(reviewId) &&
          isVerifiedOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow list: if isValidId(userId) &&
          isVerifiedOwner(userId) &&
          resource.data.ownerId == request.auth.uid;

        allow create: if false;
        allow update: if false;

        allow delete: if isValidId(userId) &&
          isValidId(placeId) &&
          isValidId(reviewId) &&
          isVerifiedOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }
    }
  }
}
