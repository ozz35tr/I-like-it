{
  "entities": {
    "Place": {
      "title": "Place",
      "description": "A visited restaurant, cafe, bakery, or bistro saved by the authenticated user with optional Google Maps share link and aggregated rating.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Place or restaurant name.",
          "minLength": 2,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Category key.",
          "enum": ["restaurant", "cafe", "bakery", "bistro"]
        },
        "mapsUrl": {
          "type": "string",
          "description": "Optional Google Maps share URL.",
          "minLength": 0,
          "maxLength": 600
        },
        "coverImage": {
          "type": "string",
          "description": "Optional compressed JPEG cover image data URL.",
          "minLength": 0,
          "maxLength": 160000
        },
        "latestComment": {
          "type": "string",
          "description": "Most recent review comment summary for list display.",
          "minLength": 0,
          "maxLength": 1500
        },
        "avgRating": {
          "type": "number",
          "description": "Average star rating from 0 to 5."
        },
        "reviewCount": {
          "type": "number",
          "description": "Total number of reviews."
        },
        "ratingSum": {
          "type": "number",
          "description": "Sum of all review star ratings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "mapsUrl",
        "coverImage",
        "latestComment",
        "avgRating",
        "reviewCount",
        "ratingSum",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "A rating, comment, and optional compressed photos for a saved place.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the review author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "placeId": {
          "type": "string",
          "description": "Parent place document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rating": {
          "type": "number",
          "description": "Integer star rating between 1 and 5."
        },
        "comment": {
          "type": "string",
          "description": "User review text.",
          "minLength": 2,
          "maxLength": 1500
        },
        "photos": {
          "type": "array",
          "description": "Up to 2 compressed JPEG image data URLs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "placeId",
        "rating",
        "comment",
        "photos",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/places/{placeId}": {
      "schema": { "$ref": "#/entities/Place" },
      "description": "Per-user private list of visited places synced across devices."
    },
    "/users/{userId}/places/{placeId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews and optional compressed photos belonging to a user's saved place."
    }
  }
}
