{
  "entities": {
    "Place": {
      "title": "Place",
      "description": "A visited restaurant, cafe, bakery, or bistro shared across signed-in users with author attribution, optional Google Maps share link, and aggregated star rating.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the user who created the place.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the creator (non-PII).",
          "minLength": 1,
          "maxLength": 60
        },
        "visibility": {
          "type": "string",
          "description": "Shared visibility marker.",
          "enum": ["shared"]
        },
        "name": {
          "type": "string",
          "description": "Place or restaurant name.",
          "minLength": 2,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Venue category key.",
          "enum": ["restaurant", "cafe", "bakery", "bistro"]
        },
        "visitStatus": {
          "type": "string",
          "description": "Whether the place has been visited or is on the wishlist to visit.",
          "enum": ["visited", "wishlist"]
        },
        "cuisineType": {
          "type": "string",
          "description": "Product or cuisine specialty (e.g., Kebap, Çiğ Köfte, Kokoreç, Hamburger, Balık).",
          "minLength": 0,
          "maxLength": 40
        },
        "mapsUrl": {
          "type": "string",
          "description": "Optional Google Maps share URL.",
          "minLength": 0,
          "maxLength": 600
        },
        "coverImage": {
          "type": "string",
          "description": "Optional compressed JPEG cover image data URL.",
          "minLength": 0,
          "maxLength": 160000
        },
        "latestComment": {
          "type": "string",
          "description": "Most recent review comment or wishlist note summary.",
          "minLength": 0,
          "maxLength": 1500
        },
        "avgRating": {
          "type": "number",
          "description": "Average star rating from 0 to 5."
        },
        "reviewCount": {
          "type": "number",
          "description": "Total number of reviews."
        },
        "ratingSum": {
          "type": "number",
          "description": "Sum of all review star ratings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "authorName",
        "visibility",
        "name",
        "category",
        "mapsUrl",
        "coverImage",
        "latestComment",
        "avgRating",
        "reviewCount",
        "ratingSum",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "A rating, comment, author attribution, and optional compressed photos for a shared place.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the review author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the review author (non-PII).",
          "minLength": 1,
          "maxLength": 60
        },
        "visibility": {
          "type": "string",
          "description": "Shared visibility marker.",
          "enum": ["shared"]
        },
        "placeId": {
          "type": "string",
          "description": "Parent place document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rating": {
          "type": "number",
          "description": "Integer star rating between 1 and 5."
        },
        "comment": {
          "type": "string",
          "description": "User review text.",
          "minLength": 2,
          "maxLength": 1500
        },
        "photos": {
          "type": "array",
          "description": "Up to 2 compressed JPEG image data URLs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "authorName",
        "visibility",
        "placeId",
        "rating",
        "comment",
        "photos",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/places/{placeId}": {
      "schema": { "$ref": "#/entities/Place" },
      "description": "Shared community list of visited places visible to all verified signed-in users."
    },
    "/places/{placeId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews, ratings, author names, and optional compressed photos on a shared place."
    },
    "/users/{userId}/places/{placeId}": {
      "schema": { "$ref": "#/entities/Place" },
      "description": "Legacy per-user private places collection retained for one-click migration to the shared list."
    },
    "/users/{userId}/places/{placeId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Legacy per-user private reviews retained for one-click migration to the shared list."
    }
  }
}
